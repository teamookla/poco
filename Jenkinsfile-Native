import java.util.regex.Pattern

def OPENSSL_VERSION = "3.5.8"
MUSL_GCC_VERSION = "15.1"

def agents = [
  deb13_64bit:   [ label: 'native-deb13-64' ],
  freebsd_jail:  [ label: 'freebsd-jail', injectGHKey: true, ccache: true ],
  macos:         [ label: 'macos' ],
  win32:         [ label: 'windows-build-pool' ],
  win64:         [ label: 'windows-build-pool' ]
]

def builds = [
  'linux-x86_64-static-musl':   [ agent: agents.deb13_64bit, openssl: "static-x86_64-musl", toolchain: 'static-musl-x86_64-linux-musl' ],
  'linux-aarch64-static-musl':  [ agent: agents.deb13_64bit, openssl: "static-aarch64-musl", toolchain: 'static-musl-aarch64-linux-musl' ],
  'freebsd14-x86_64':           [ agent: agents.freebsd_jail, platform: 'freebsd14-x86_64', openssl: 'freebsd14-x86_64',
                                  toolchain: "none", jail: 'fbsd14'],
  'freebsd15-x86_64':           [ agent: agents.freebsd_jail, platform: 'freebsd15-x86_64', openssl: 'freebsd15-x86_64',
                                  toolchain: "none", jail: 'fbsd15' ],
  'freebsd14-arm64':            [ agent: agents.freebsd_jail, platform: 'freebsd14-arm64', openssl: 'freebsd14-arm64',
                                  toolchain: "none", jail: 'fbsd14' ],
  'freebsd15-arm64':            [ agent: agents.freebsd_jail, platform: 'freebsd15-arm64', openssl: 'freebsd15-arm64',
                                  toolchain: "none", jail: 'fbsd15' ],
  'macosx':         [ agent: agents.macos, openssl: 'macos', toolchain: "none" ],
  'windows32':      [ agent: agents.win32, winPlatform:'x86', openssl: 'win32', toolchain: "none" ],
  'windows64':      [ agent: agents.win64, winPlatform:'x64', openssl: 'win64', toolchain: "none" ],
]

def createBuildStages(builds) {
  builds.collectEntries { name, definition ->
    [ "${name}": createBuildStage(name, definition) ]
  }
}

def createBuildStage(name, definition) {
  return {
    stage(name) {

      node(definition.agent.label) {
        ws("workspace/" + generateWorkspaceName("${env.APPLICATION_NAME}-${env.BRANCH_NAME}-${name}")) {
          checkout scm

          def isMuslToolchain = definition.toolchain?.startsWith('static-musl-')
          def toolchainTag = isMuslToolchain ? "${definition.toolchain}-gcc-${MUSL_GCC_VERSION}"
                                             : (definition.toolchain ?: name)

          def ccacheFile =  "none"
          if(definition.agent.ccache ) {
            ccacheFile = "poco-${name}-${definition.platform ?: definition.agent.label}-${toolchainTag}-ccache.tgz"
          }

          withEnv([
            "PLATFORM=${definition.platform ?: name}",
            "JENKINS_PLATFORM=${definition.platform ?: name}",
            "TOOLCHAIN_NAME=${definition.toolchain ?: name}",
            "MUSL_GCC_VERSION=${MUSL_GCC_VERSION}",
            "CCACHE_FILE=${ccacheFile}",
            "FREEBSD_JAIL=${definition.jail ?: ''}",
          ]) {
            if (definition.agent.injectGHKey) {
              withCredentials([[
                $class: 'SSHUserPrivateKeyBinding',
                credentialsId: 'jenkins-ssh-key',
                keyFileVariable: 'ID_RSA_FILE',
              ]]) {
                sh "rm -f ~/.ssh/id_rsa; cp \\${ID_RSA_FILE} ~/.ssh/id_rsa"
              }

            }

            withAwsCredentials('jenkins-native-builds') {
              sh """
                      aws s3 cp --no-progress s3://ookla-native-toolchains/openssl-${OPENSSL_VERSION}-${definition.openssl}.tar.gz openssl.tgz
                      tar xzf openssl.tgz
                      rm openssl.tgz
                    """
              if(definition.toolchain != 'none') {
                def s3prefix = isMuslToolchain ? "musl-gcc-${MUSL_GCC_VERSION}/" : ""
                sh """
                      aws s3 cp --no-progress s3://ookla-native-toolchains/${s3prefix}${definition.toolchain}.tgz toolchain.tgz
                      mkdir -p /home/jenkins/toolchains
                      tar xzf toolchain.tgz -C /home/jenkins/toolchains
                      rm toolchain.tgz
                    """
              }

              ['Debug', 'Release'].each { buildType ->
                dir("cmake_build_${buildType}") {
                  deleteDir()
                }
                dir("cmake_install_${buildType}") {
                  deleteDir()
                }
              }

              if (isUnix()) {
                // Poco 1.15.3 requires cmake >= 3.26 (cmake_minimum_required in
                // CMakeLists.txt); the agent's cmake must satisfy that. The old
                // /opt/cmake-3.11.4/bin PATH entry was dropped -- it was appended
                // after $PATH so it never took effect, and 3.11.4 is now too old
                // to configure the project at all.
                sh 'exec ./jenkins.sh'
              } else {
                msvcBat '"c:/Program Files/Git/bin/bash.exe" -x ./jenkins.sh', [winPlatform: definition.winPlatform]
              }

              def version = env.BRANCH_NAME
              def m = Pattern.compile("${APPLICATION_NAME}-(\\d+.\\d+.\\d+)").matcher(env.BRANCH_NAME)
              if (m.matches()) {
                version = m.getAt(0)[1]
              }
              m = null

              ['Debug', 'Release'].each { buildType ->
                sh "rm -f cmake_install_${buildType}.zip"
                zip zipFile:"cmake_install_${buildType}.zip", dir:"cmake_install_${buildType}"
                s3Upload(
                  bucket:'ookla-native-artifacts',
                  path:"${APPLICATION_NAME}/${env.BRANCH_NAME}/${APPLICATION_NAME}-${version}-${PLATFORM}-${buildType}.zip",
                  file:"cmake_install_${buildType}.zip")
              }
            }
          }
        }
      }
    }
  }
}

pipeline {
  agent none
  environment {
    APPLICATION_NAME = "poco"
    BUILD_TIMESTAMP = "${timeStamp}"
    OPENSSL_VERSION = "${OPENSSL_VERSION}"
  }
  stages {
    stage('Build All') {
      steps {
        script {
          throttle(['fargate']) {
            parallel createBuildStages(builds)
          }
        }
      }
    }
  }
}
